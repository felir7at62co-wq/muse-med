{
  "initial": [
    {
      "name": "structured_output",
      "description": "Report your final structured result. Call this exactly once, when your answer is complete; the arguments must match this tool's parameter schema exactly.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "findings",
          "unknowns",
          "episode_checks"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "consistent",
              "issues",
              "unknown"
            ],
            "description": "consistent requires findings=[] and unknowns=[]. issues requires findings. unknown requires substantive unknowns. Never discard real uncertainties just to select consistent."
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "description",
                "evidence"
              ],
              "properties": {
                "category": {
                  "type": "string",
                  "enum": [
                    "event_order",
                    "character_state",
                    "information_state",
                    "object_state",
                    "transition"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "role",
                      "path",
                      "file_sha256",
                      "text_sha256",
                      "line",
                      "quote"
                    ],
                    "properties": {
                      "role": {
                        "type": "string",
                        "enum": [
                          "current",
                          "candidate"
                        ],
                        "description": "Copy the exact document.role identity label. reference means only a document whose role is reference, never an earlier passage or a flashback."
                      },
                      "path": {
                        "type": "string",
                        "description": "Copy the exact path of that same material document; do not infer or rewrite it.",
                        "enum": [
                          "{{cwd}}/current.md",
                          "{{cwd}}/candidate.md"
                        ]
                      },
                      "file_sha256": {
                        "type": "string",
                        "description": "Copy file_sha256 verbatim from the same document as role and path.",
                        "enum": [
                          "acece633b63d1cbb437fd534d55705344f7e7c08fa0e2579873cbb0269109e97",
                          "dee084be8b9b659eeb643e502f5c7f5fe7b750d1820acfbc15be8fcd39d35d79"
                        ]
                      },
                      "text_sha256": {
                        "type": "string",
                        "description": "Copy text_sha256 verbatim from the same document as role and path.",
                        "enum": [
                          "acece633b63d1cbb437fd534d55705344f7e7c08fa0e2579873cbb0269109e97",
                          "dee084be8b9b659eeb643e502f5c7f5fe7b750d1820acfbc15be8fcd39d35d79"
                        ]
                      },
                      "line": {
                        "type": "integer"
                      },
                      "quote": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Substantive uncertainties or missing evidence. A nonempty array cannot accompany consistent; preserve actual uncertainties and select unknown, or issues when evidenced findings are also present."
          },
          "episode_checks": {
            "type": "array",
            "description": "Exactly one assessment for every scheduled pair. Cite target text from both episodes; never invent a missing episode.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from_episode",
                "to_episode",
                "status",
                "explanation",
                "evidence"
              ],
              "properties": {
                "from_episode": {
                  "type": "integer",
                  "enum": [
                    1,
                    2
                  ]
                },
                "to_episode": {
                  "type": "integer",
                  "enum": [
                    2,
                    3
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "consistent",
                    "issues",
                    "unknown"
                  ]
                },
                "explanation": {
                  "type": "string",
                  "description": "Explain actual causal, character/knowledge, object/count and hook/opening relations; ordinary cuts are not automatically errors."
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "role",
                      "path",
                      "file_sha256",
                      "text_sha256",
                      "line",
                      "quote"
                    ],
                    "properties": {
                      "role": {
                        "type": "string",
                        "enum": [
                          "current",
                          "candidate"
                        ],
                        "description": "Copy the exact document.role identity label. reference means only a document whose role is reference, never an earlier passage or a flashback."
                      },
                      "path": {
                        "type": "string",
                        "description": "Copy the exact path of that same material document; do not infer or rewrite it.",
                        "enum": [
                          "{{cwd}}/current.md",
                          "{{cwd}}/candidate.md"
                        ]
                      },
                      "file_sha256": {
                        "type": "string",
                        "description": "Copy file_sha256 verbatim from the same document as role and path.",
                        "enum": [
                          "acece633b63d1cbb437fd534d55705344f7e7c08fa0e2579873cbb0269109e97",
                          "dee084be8b9b659eeb643e502f5c7f5fe7b750d1820acfbc15be8fcd39d35d79"
                        ]
                      },
                      "text_sha256": {
                        "type": "string",
                        "description": "Copy text_sha256 verbatim from the same document as role and path.",
                        "enum": [
                          "acece633b63d1cbb437fd534d55705344f7e7c08fa0e2579873cbb0269109e97",
                          "dee084be8b9b659eeb643e502f5c7f5fe7b750d1820acfbc15be8fcd39d35d79"
                        ]
                      },
                      "line": {
                        "type": "integer"
                      },
                      "quote": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "changes": []
}

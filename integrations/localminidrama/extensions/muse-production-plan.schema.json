{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "muse-production-plan-v1"
    },
    "project": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "default": "",
          "type": "string",
          "maxLength": 60000
        },
        "style": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "aspectRatio": {
          "type": "string",
          "enum": [
            "16:9",
            "9:16",
            "1:1",
            "4:3",
            "3:4",
            "21:9"
          ]
        }
      },
      "required": [
        "key",
        "title",
        "description",
        "style",
        "aspectRatio"
      ],
      "additionalProperties": false
    },
    "characters": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 60000
          },
          "appearance": {
            "default": "",
            "type": "string",
            "maxLength": 60000
          },
          "voiceHint": {
            "default": "",
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "key",
          "name",
          "description",
          "appearance",
          "voiceHint"
        ],
        "additionalProperties": false
      }
    },
    "scenes": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "time": {
            "default": "",
            "type": "string",
            "maxLength": 500
          },
          "prompt": {
            "default": "",
            "type": "string",
            "maxLength": 60000
          }
        },
        "required": [
          "key",
          "name",
          "location",
          "time",
          "prompt"
        ],
        "additionalProperties": false
      }
    },
    "props": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 60000
          },
          "prompt": {
            "default": "",
            "type": "string",
            "maxLength": 60000
          }
        },
        "required": [
          "key",
          "name",
          "description",
          "prompt"
        ],
        "additionalProperties": false
      }
    },
    "episodes": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "number": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "script": {
            "type": "string",
            "maxLength": 60000
          },
          "packages": {
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
                },
                "order": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "description": {
                  "default": "",
                  "type": "string",
                  "maxLength": 60000
                },
                "action": {
                  "default": "",
                  "type": "string",
                  "maxLength": 60000
                },
                "imagePrompt": {
                  "default": "",
                  "type": "string",
                  "maxLength": 60000
                },
                "videoPrompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60000
                },
                "durationSeconds": {
                  "anyOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 3600
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "characterKeys": {
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
                  }
                },
                "sceneKey": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "propKeys": {
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
                  }
                },
                "dialogue": {
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "characterKey": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60000
                      },
                      "emotion": {
                        "default": "",
                        "type": "string",
                        "maxLength": 500
                      },
                      "voiceHint": {
                        "default": "",
                        "type": "string",
                        "maxLength": 1000
                      }
                    },
                    "required": [
                      "characterKey",
                      "text",
                      "emotion",
                      "voiceHint"
                    ],
                    "additionalProperties": false
                  }
                },
                "audio": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "silent",
                        "speech",
                        "original",
                        "speech_music"
                      ]
                    },
                    "musicPrompt": {
                      "default": "",
                      "type": "string",
                      "maxLength": 60000
                    },
                    "effects": {
                      "default": [],
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      }
                    }
                  },
                  "required": [
                    "mode",
                    "musicPrompt",
                    "effects"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "key",
                "order",
                "title",
                "description",
                "action",
                "imagePrompt",
                "videoPrompt",
                "durationSeconds",
                "characterKeys",
                "sceneKey",
                "propKeys",
                "dialogue",
                "audio"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "key",
          "number",
          "title",
          "script",
          "packages"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "project",
    "characters",
    "scenes",
    "props",
    "episodes"
  ],
  "additionalProperties": false
}

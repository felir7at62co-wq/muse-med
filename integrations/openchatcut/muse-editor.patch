diff --git a/src/muse/jingliuEpisode.ts b/src/muse/jingliuEpisode.ts
new file mode 100644
index 0000000000000000000000000000000000000000..10273305d7d7721a929c31933c4b05e9af432d04
--- /dev/null
+++ b/src/muse/jingliuEpisode.ts
@@ -0,0 +1,104 @@
+import type { MediaAsset, Timeline } from '../editor/types';
+import { createMediaSourceRevision } from '../editor/mediaSourceRevision';
+import { activeTimeline } from '../editor/projectTypes';
+import { probeMediaFile } from '../media/mediaProbe';
+import { emptyProjectDoc } from '../app/appShell';
+import {
+  createMediaBlobImportNamespace, stageMediaBlobImport, discardMediaBlobImport, type StagedMediaBlobImportEntry,
+} from '../persist/mediaBlobStore';
+import { publishDirectMediaProject } from '../persist/projectTransfer';
+
+interface Clip {
+  order: number;
+  inSec: number;
+  durationSec: number;
+  speed: number;
+  track: number;
+  overlayStart: number;
+  file: Blob;
+}
+interface Episode { name: string; aspect: string; clips: Clip[] }
+
+const record = (v: unknown): v is Record<string, unknown> => !!v && typeof v === 'object';
+const finite = (v: unknown, lo: number, hi: number): v is number => typeof v === 'number' && Number.isFinite(v) && v >= lo && v <= hi;
+const extensions: Record<string, string> = { 'video/mp4': 'mp4', 'video/quicktime': 'mov', 'video/webm': 'webm' };
+
+export function parseEpisode(value: unknown): Episode {
+  if (!record(value) || typeof value.name !== 'string' || !value.name.trim() || value.name.length > 256 ||
+      typeof value.aspect !== 'string' || value.aspect.length > 32 ||
+      !Array.isArray(value.clips) || !value.clips.length || value.clips.length > 120) throw Error('episode');
+  let bytes = 0;
+  const clips = value.clips.map((c: unknown): Clip => {
+    if (!record(c) || !(c.file instanceof Blob) || !Object.hasOwn(extensions, c.file.type) ||
+        c.file.size <= 0 || c.file.size > 256 * 1024 * 1024 ||
+        !finite(c.order, 0, 1e6) || !Number.isInteger(c.order) ||
+        !finite(c.inSec, 0, 86400) || !finite(c.durationSec, 0.001, 86400) ||
+        !finite(c.speed, 0.01, 16) || !finite(c.track, 0, 128) || !Number.isInteger(c.track) ||
+        !finite(c.overlayStart, 0, 86400)) throw Error('clip');
+    bytes += c.file.size;
+    if (bytes > 1024 * 1024 * 1024) throw Error('size');
+    return { order: c.order, file: c.file, inSec: c.inSec, durationSec: c.durationSec, speed: c.speed, track: c.track, overlayStart: c.overlayStart };
+  });
+  return { name: value.name, aspect: value.aspect, clips: clips.sort((a, b) => a.order - b.order) };
+}
+
+/** Place one adopted source window on the main track or its original overlay track. */
+export function placeClip(timeline: Timeline, asset: MediaAsset, clip: Omit<Clip, 'file'>, primaryEnd: number) {
+  const track = 'track_v' + (clip.track + 1);
+  timeline.tracks ??= {};
+  timeline.tracks[track] = { kind: 'video' };
+  timeline.trackOrder = Object.keys(timeline.tracks).sort((a, b) => Number(b.slice(7)) - Number(a.slice(7)));
+  const startFrame = clip.track ? Math.round(clip.overlayStart * timeline.fps) : primaryEnd;
+  const srcInFrame = Math.round(clip.inSec * timeline.fps);
+  const span = Math.min(asset.durationInFrames - srcInFrame, Math.round(clip.durationSec * timeline.fps));
+  if (span < 1) throw Error('invalid source window');
+  const durationInFrames = Math.max(1, Math.round(span / clip.speed));
+  timeline.items.push({ id: crypto.randomUUID(), track, startFrame, durationInFrames,
+    srcInFrame, playbackRate: clip.speed, kind: 'video', src: asset.src, name: asset.name,
+    width: asset.width, height: asset.height, sourceFilename: asset.name, sourceContentHash: asset.sourceContentHash });
+  return clip.track ? primaryEnd : startFrame + durationInFrames;
+}
+
+export async function importJingliuEpisode(value: unknown, signal: AbortSignal): Promise<string> {
+  const episode = parseEpisode(value);
+  const doc = emptyProjectDoc();
+  const timeline = activeTimeline(doc);
+  timeline.name = episode.name;
+  const namespace = createMediaBlobImportNamespace();
+  const entries = new Map<string, StagedMediaBlobImportEntry>();
+  let primaryEnd = 0;
+  try {
+    for (const clip of episode.clips) {
+      signal.throwIfAborted();
+      const ext = extensions[clip.file.type];
+      const name = 'Shot ' + clip.order + '.' + ext;
+      const file = new File([clip.file], name, { type: clip.file.type });
+      const metadata = await probeMediaFile(file, 'video', timeline.fps);
+      if (!metadata.width || !metadata.height || !Number.isFinite(metadata.durationInFrames)) throw Error('unreadable video');
+      const stage = await stageMediaBlobImport(namespace, '/media/uploads/' + name, file, { name, mime: file.type, sourceSize: file.size });
+      let asset = doc.assets.find(a => a.src === stage.src);
+      if (!asset) {
+        entries.set(stage.src, stage);
+        asset = { id: crypto.randomUUID(), src: stage.src, name, sourceFilename: name, kind: 'video',
+          sourceSize: file.size, sourceContentHash: stage.sha256, ...metadata };
+        asset.sourceRevision = createMediaSourceRevision(asset);
+        doc.assets.push(asset);
+      }
+      primaryEnd = placeClip(timeline, asset, clip, primaryEnd);
+      if (doc.assets.length === 1 && timeline.items.length === 1) {
+        const [w, h] = episode.aspect.split(':').map(Number);
+        if (w > 0 && h > 0 && w / h >= .1 && w / h <= 10) {
+          const long = Math.max(metadata.width, metadata.height);
+          timeline.width = Math.max(2, Math.round((long * w / Math.max(w, h)) / 2) * 2);
+          timeline.height = Math.max(2, Math.round((long * h / Math.max(w, h)) / 2) * 2);
+        } else { timeline.width = metadata.width; timeline.height = metadata.height; }
+      }
+    }
+    signal.throwIfAborted();
+    const result = await publishDirectMediaProject(episode.name, doc, namespace, [...entries.values()], signal);
+    return result.meta.id;
+  } catch (error) {
+    await discardMediaBlobImport(namespace);
+    throw error;
+  }
+}

+/** Integer output viewport when Remotion cannot pass the scaled size directly to its encoder. */
+export function scaledOutputViewport(width, height, scale, codec) {
+  const step = codec === 'h264' ? 2 : 1;
+  const nearest = (pixels) => Math.max(step, Math.round(pixels / step) * step);
+  const scaledWidth = width * scale;
+  const scaledHeight = height * scale;
+  const outputWidth = nearest(scaledWidth);
+  const outputHeight = nearest(scaledHeight);
+  return scaledWidth === outputWidth && scaledHeight === outputHeight
+    ? undefined : { width: outputWidth, height: outputHeight };
+}

diff --git a/src/muse/jingliuBridge.ts b/src/muse/jingliuBridge.ts
new file mode 100644
index 0000000000000000000000000000000000000000..187987a79115d24339d641f8651c8b546d0f37fb
--- /dev/null
+++ b/src/muse/jingliuBridge.ts
@@ -0,0 +1,54 @@
+const kind = 'muse.jingliu.cut.v1';
+
+export function allowedMuseParent(origin: string, configured: string): boolean {
+  if (origin === 'dsh-app://app') return true;
+  return configured.split(',').some(entry => {
+    try {
+      const url = new URL(entry.trim());
+      return url.origin === origin && url.origin === entry.trim() && ['http:', 'https:'].includes(url.protocol)
+        && ['127.0.0.1', '[::1]'].includes(url.hostname);
+    } catch { return false; }
+  });
+}
+
+/** Accept a short-lived dedicated port only from the explicitly configured Muse parent. */
+export function bindJingliuBridge(
+  win: Window, configured: string, importProject: (payload: unknown, signal: AbortSignal) => Promise<string>,
+  openProject: (id: string) => Promise<void>,
+): () => void {
+  let current: { id: string; abort: AbortController; port: MessagePort; timer: ReturnType<typeof setTimeout> } | undefined;
+  const stop = () => {
+    if (!current) return;
+    clearTimeout(current.timer);
+    current.abort.abort();
+    current.port.close();
+    current = undefined;
+  };
+  const handler = (event: MessageEvent) => {
+    const id = event.data?.id;
+    if (win.parent === win || event.source !== win.parent || !allowedMuseParent(event.origin, configured) ||
+        event.data?.kind !== kind || typeof id !== 'string' || !/^[a-f0-9-]{36}$/i.test(id) || event.ports.length !== 1) return;
+    const port = event.ports[0];
+    if (current) { port.postMessage({ id, state: 'error' }); port.close(); return; }
+    const abort = new AbortController();
+    current = { id, abort, port, timer: setTimeout(stop, 20 * 60_000) };
+    let started = false;
+    port.onmessage = async message => {
+      if (message.data?.id !== id || current?.id !== id) return;
+      if (message.data?.state === 'cancel') { stop(); return; }
+      if (started) return;
+      started = true;
+      try {
+        const projectId = await importProject(message.data, abort.signal);
+        if (abort.signal.aborted) return;
+        port.postMessage({ id, state: 'imported' });
+        await openProject(projectId);
+      } catch {
+        if (!abort.signal.aborted) port.postMessage({ id, state: 'error' });
+      } finally { if (current?.id === id) stop(); }
+    };
+    port.postMessage({ id, state: 'ready' });
+  };
+  win.addEventListener('message', handler);
+  return () => { win.removeEventListener('message', handler); stop(); };
+}

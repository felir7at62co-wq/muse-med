{
  "name": "@deepseek-ai/dsh-perception-bgm",
  "description": "Non-commercial BGM emotion analysis and valence/arousal matching for the DeepSeek Harness",
  "version": "0.2.1-alpha.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/config.js",
    "lib/worker.js",
    "python/*.py",
    "python/vendored/*.py",
    "python/data/*.json",
    "python/data/*.yaml",
    "python/data/tag_list.npy",
    "python/LICENSE-Music2Emo",
    "SOURCES.md",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-tools": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-util-values": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-tools": "workspace:*"
  }
}

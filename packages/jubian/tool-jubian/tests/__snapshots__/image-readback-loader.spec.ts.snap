exports[`logs a failed image task with its original identity instead of an envelope error > failed original image task 1`] = `
[
  {
    "content": [
      {
        "text": "{
  "image": null,
  "generation": {
    "status": "failed",
    "task_id": 545217,
    "result_id": 1104411,
    "error_code": "reference_limit",
    "max_reference_images": 5
  },
  "guidance": "原任务已失败，保留原任务号与回执。修正已确认的原因后才可提交新的修订请求。"
}",
        "type": "text",
      },
    ],
    "isError": false,
  },
]
`;


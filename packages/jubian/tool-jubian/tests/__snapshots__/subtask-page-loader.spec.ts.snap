// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`exposes subtask rows in PTC output types while accepting other video-method results > video output type with paged subtask rows 1`] = `
"{
  sources?: {
    script_id: number;
    storyboard_id: number;
    queried_at: string;
    complete: boolean;
    status: "available" | "pending" | "none_found" | "unknown";
    sources: ({
      task_id: number;
      subtask_id: number;
      first_result_id: number | null;
      video_url: string;
      status: string;
    } & Record<string, JsonValue>)[];
    issues: string[];
    next: string;
  } & Record<string, JsonValue>;
  tasks?: {
    queried_at: string;
    page_num: number;
    page_size: number;
    returned: number;
    /** 提供方返回有效数值 total；不是独立核验全部历史。 */
    total_verified: boolean;
    /** 仅本次响应覆盖相应查询范围全部结果时为 true；末页不代表已读过前页。 */
    complete: boolean;
    has_more: boolean | null;
    next_page: number | null;
    /** 本次总数与完整性对应的查询范围；task_type=null 表示不按类型筛选。 */
    scope: {
      script_id: number;
      task_type: number | null;
    };
    /** 仅本次未按任务类型筛选且完整读到提供方项目列表时为 true；不保证提供方保留全部历史。 */
    project_complete: boolean;
    total: number;
    rows: Record<string, JsonValue>[];
  } & Record<string, JsonValue>;
  /** method=subtasks 的分页对象；子结果数组位于 subtasks.rows。 */
  subtasks?: {
    queried_at: string;
    page_num: number;
    page_size: number;
    returned: number;
    /** 提供方返回有效数值 total；不是独立核验全部历史。 */
    total_verified: boolean;
    /** 仅本次响应覆盖相应查询范围全部结果时为 true；末页不代表已读过前页。 */
    complete: boolean;
    has_more: boolean | null;
    next_page: number | null;
    /** 提供方报告的子结果总数；不是数组。 */
    total: number;
    /** 本页子结果；逐项核对 parent_task_id、status 和 video_url。 */
    rows: ({
      subtask_id: number;
      /** 所属父任务；下载前必须与查询的 task_id 一致。 */
      parent_task_id: number | null;
      /** 提供方子结果状态；保留未知值，不能仅凭 URL 判成功。 */
      status: string | null;
      /** 当前成片 URL；本任务子结果成功且 URL 非空时才可交 jubian_media download。 */
      video_url: string | null;
    } & Record<string, JsonValue>)[];
  };
  guidance?: string;
} & Record<string, JsonValue>"
`;

exports[`logs provider-limited empty discovery before reading a known task without changing its original key > empty provider list followed by known original task and key 1`] = `

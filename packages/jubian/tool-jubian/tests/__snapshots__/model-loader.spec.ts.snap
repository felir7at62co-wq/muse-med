exports[`loads model preview/apply, renders free outcomes, and disposes registration > storyboard creation and discovery schema 1`] = `
{
  "properties": {
    "audio_references": {
      "description": "audio_preview 必填：最终完整、有序的音频引用列表；[] 明确移除全部声音引用，保留原图片。",
      "items": {
        "additionalProperties": false,
        "properties": {
          "audioDuration": {
            "description": "实测秒数，大于0且不超过15；未知时省略，不按文件名猜测。",
            "type": "number",
          },
          "audio_asset_id": {
            "description": "已登记的真实音频资产 ID；工具复验同项目、类别4与URL，字段不伪造图片父资产 ID。",
            "type": "integer",
          },
          "character_id": {
            "description": "可选本地稳定角色 ID；提供后须与当前项目该角色声线的资产 ID、URL 精确一致，不发送给视频提供方。",
            "type": "string",
          },
          "fileName": {
            "type": "string",
          },
          "materialKey": {
            "type": "string",
          },
          "materialName": {
            "type": "string",
          },
          "materialType": {
            "enum": [
              "audio",
            ],
            "type": "string",
          },
          "materialUrl": {
            "type": "string",
          },
          "sortOrder": {
            "description": "从 1 开始的音频组内连续顺序。",
            "type": "integer",
          },
          "voice_period_id": {
            "description": "同角色的明确人生时期 ID，如 child/adult；角色有分期声线时必须提供，不能回退或混用。须同时提供 character_id。",
            "type": "string",
          },
        },
        "required": [
          "materialType",
          "materialKey",
          "materialUrl",
          "sortOrder",
        ],
        "type": "object",
      },
      "type": "array",
    },
    "authorization_basis": {
      "description": "delete_preview 必填：用户对本次精确范围的删除授权；不明确时 ask_user。",
      "type": "string",
    },
    "body": {
      "additionalProperties": true,
      "description": "create 与 body_path 二选一。创建字段：scriptId=当前项目远端 ID；episodeId=jubian_catalog episodes 返回的真实分集 ID（不是集号）；episodeCount=显示集号；scriptName=项目名；storyboardName=包名，如 EP01-P1；sortOrder=从 0 开始的包序号；isGenerate=0。视频模型、平台、比例、分辨率和风格沿用当前项目；每包 duration 按镜头内容计算，不能照抄项目默认时长。modelConfig 是 JSON 字符串：包含完整包 prompt、duration（整数秒，含收束）、modelId、platformId、ratio、resolution、genType、genNum=1、standardId、modelGenerationTypeId、videoStandardId；模型与选择器取当前 jubian_catalog models(task_type=1)，不要抄历史 ID。提示词必须写入 modelConfig.prompt，不能只放顶层 prompt；用到的已有素材在对应镜头的画面、动作或声音描述中内联使用 \`@[素材名称](material_key)\`，后续镜头再次提及时继续引用，不能只在顶部集中列出。只引用本包实际用到的现有素材，不为补引用新增资产，不把标记插入原文对白。图片 selections 按正文图片 key 首次出现的顺序去重后各绑定一次，正文重复引用不重复绑定；音频用 audio_preview/audio_apply，不混入图片 selections。get 的 model_config.prompt 是保存的提示词，material_keys 来自已绑定素材；新分镜 material_keys 为空不代表提示词为空。主体素材后续用 select_assets 写入；新建不要复制旧记录的 id、任务列表或账号字段。创建后从响应取 ID 并 get 回读核对提示词，再继续下一批；无需用户先手工创建样本。",
      "type": "object",
    },
    "body_path": {
      "description": "create 与 body 二选一：按 body 的字段说明生成并检查的本地 UTF-8 JSON 文件路径；一包一份请求体。",
      "type": "string",
    },
    "changes": {
      "additionalProperties": false,
      "description": "edit_preview 必填：仅修改提供的字段，其余原样保留；duration 是所选模型实际请求的整数秒。",
      "properties": {
        "duration": {
          "description": "正整数秒；SD2.0 为4–15秒，SD2.5 为4–30秒，其他目录模型按各自能力与镜头内容确定。",
          "type": "integer",
        },
        "episode_id": {
          "description": "项目内的远端分集 ID；先读 episodes，不是集号。",
          "type": "integer",
        },
        "genNum": {
          "type": "integer",
        },
        "genType": {
          "type": "integer",
        },
        "modelId": {
          "type": "string",
        },
        "name": {
          "type": "string",
        },
        "platformId": {
          "type": "string",
        },
        "prompt": {
          "description": "新的完整包提示词；已有素材按所在镜头内联引用，不以顶部素材清单代替；素材标记或首次出现顺序改变后须重新选源。",
          "type": "string",
        },
        "ratio": {
          "type": "string",
        },
        "resolution": {
          "type": "string",
        },
        "sort_order": {
          "type": "integer",
        },
      },
      "type": "object",
    },
    "checked_storyboard_ids": {
      "description": "delete_apply 必填：逐张核对 preview 内容后的完整目标 ID 列表；idempotency_key 使用 fingerprint。",
      "items": {
        "type": "integer",
      },
      "type": "array",
    },
    "content_duration_ms": {
      "description": "prepare_video / generate 准备阶段可选：内容时长交叉校验，等于已保存卡时长减 1 秒后的毫秒数；不用于修改时长。",
      "type": "number",
    },
    "delete_reason": {
      "description": "delete_preview 必填：具体删除原因，如这些 ID 是已被正式包替代的测试卡。",
      "type": "string",
    },
    "edits": {
      "description": "edit_batch_preview 必填：全部改动检查后一次传入；每项 storyboard_id 与 changes，分镜 ID 不重复。",
      "items": {
        "additionalProperties": false,
        "properties": {
          "changes": {
            "additionalProperties": true,
            "type": "object",
          },
          "storyboard_id": {
            "type": "integer",
          },
        },
        "required": [
          "storyboard_id",
          "changes",
        ],
        "type": "object",
      },
      "type": "array",
    },
    "episode": {
      "description": "可选：集号（\`5\` 与 \`05\` 都规范成 \`EP05\`）或配置的跨集母版标记（默认「全剧」）。给了它，资产名会按规范组合成 \`EP05｜角色｜陆沉舟\`，处理任务名会加上 \`EP05-P3-\` 这样的可排序前缀；不给就完全按调用方原样使用 asset_name / task_name。",
      "type": "string",
    },
    "erase_mode": {
      "description": "新列出的去字幕模型须显式选自动或区域擦除；已知模型省略时沿用原路由。",
      "enum": [
        "automatic",
        "region",
      ],
      "type": "string",
    },
    "estimate_basis": {
      "description": "本包估价依据：模型/平台、价格单位、时长/用量假设或同规格实际费用。提供估价时必填；估算不是实际结算金额。",
      "type": "string",
    },
    "estimated_cost_cny": {
      "description": "本包预计费用（人民币十进制字符串）。由 Agent 按项目所选模型的实时目录价格、包时长/用量或同规格已结算费用估算；不是让用户填写，也不改变每项目默认4000元额度。",
      "type": "string",
    },
    "expected_fingerprint": {
      "description": "audio_apply 必填：已检查的 audio_preview fingerprint；idempotency_key 必须相同。",
      "type": "string",
    },
    "idempotency_key": {
      "description": "generate 不带预览时可省略；提交须原样使用预览返回的 idempotencyKey（指纹），旧操作对账使用原 key。写方法必须提供 idempotency_key（批量方法在每个项目里提供）：同一请求的同一个 key 不会重复发送，重复调用会返回既有记录（replayed=true）；不同请求不能复用 key。超时或结果未知时不要换 key 重试——先用同一个 key 再调一次。",
      "type": "string",
    },
    "include_generated_media": {
      "description": "delete_preview 可选，默认 false；只有用户明确授权删除关联生成媒体时为 true，运行中的任务仍不能删除。",
      "type": "boolean",
    },
    "method": {
      "description": "list=按 script_id 分页读已有分镜；get=读分镜（含 model_config 与素材键）；create=按 body 字段说明新建；create_batch=整批预检后并行免费创建分镜；save=仅将现卡存为不生成，不写新提示词；edit_preview/edit_batch_preview=原位修改单卡/多卡预览并提醒写入前检查；edit_apply=应用预览（免费）；generate=兼容入口，无预览仅准备、有预览按原 key 提交（计费）；select_assets=写入选定资产（免费，强制 isGenerate=0）；prepare_video=免费同步本会话模型后准备并落 preview；submit_video=按 preview 提交一次（计费、异步）；submit_video_batch=整包预检后并行提交多个独立分镜（逐项计费、异步）；delete_preview=检查删除目标；delete_apply=按检查结果删除卡（不可恢复）；erase_subtitle=去字幕（异步；火山模型实时零价时免费）；audio_preview=预览原卡音频引用替换；audio_apply=应用并真实回读（免费，不新建、不生成）。",
      "enum": [
        "list",
        "get",
        "create",
        "create_batch",
        "save",
        "edit_preview",
        "edit_batch_preview",
        "edit_apply",
        "generate",
        "select_assets",
        "prepare_video",
        "submit_video",
        "submit_video_batch",
        "erase_subtitle",
        "delete_preview",
        "delete_apply",
        "audio_preview",
        "audio_apply",
      ],
      "type": "string",
    },
    "model_id": {
      "description": "erase_subtitle 必填、upscale 可选：相应任务类型实时目录的精确 modelId。已知去字幕模型包括 quzimuToB（区域性）或 ark-erase-video-subtitle-pro（自动）。去字幕省略模型会报错；转高清省略模型沿用 SeedVR2。",
      "type": "string",
    },
    "package_number": {
      "description": "erase_subtitle / upscale 可选：本集内的包号，配合 episode 生成 \`EP05-P3\` 前缀。",
      "type": "string",
    },
    "page_num": {
      "description": "页码，默认 1。",
      "type": "number",
    },
    "page_size": {
      "description": "每页条数，默认 20，上限 1000。",
      "type": "number",
    },
    "platform_id": {
      "description": "去字幕可选：task_type=10 目录的精确 platformId。",
      "type": "string",
    },
    "preview_path": {
      "description": "submit_video / generate 提交阶段：准备结果返回的 preview_path，不要猜测或手写文件名；新 generate 不带此项时仅准备预览。",
      "type": "string",
    },
    "project_dir": {
      "description": "prepare_video / generate 准备阶段必填、submit_video 可选：项目目录，必须含 project_config.json，且其 jubian_script_id 必须等于实时 scriptId。",
      "type": "string",
    },
    "prompt": {
      "description": "audio_preview 必填：完整新提示词，原图片素材标记及其顺序必须保留，声音标记与 audio_references 一一对应。",
      "type": "string",
    },
    "script_id": {
      "description": "剧变项目 ID（scriptId）。erase_subtitle 与 upscale 从任务行读取它，不必单独提供；其余方法按上面的必填说明传入。",
      "type": "number",
    },
    "selections": {
      "description": "select_assets 必填：有序的 (material_key, 父 asset_id) 列表，每个图片 key 仅传一次，顺序与正文内联引用的图片 key 首次出现顺序一致；不要求包首素材清单。已有音频参考自动保留，不传作图片 selections。",
      "items": {
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "description": "主体设定行的父资产 ID（materials 返回的 asset_id）。",
            "type": "number",
          },
          "material_key": {
            "description": "提示词里 @[名称](key) 的 key。",
            "type": "string",
          },
        },
        "required": [
          "material_key",
          "asset_id",
        ],
        "type": "object",
      },
      "type": "array",
    },
    "storyboard_id": {
      "description": "分镜 ID。",
      "type": "number",
    },
    "storyboard_ids": {
      "description": "delete_preview 必填：精确远端分镜 ID，不能重复；只能是用户授权清理的范围。",
      "items": {
        "type": "integer",
      },
      "type": "array",
    },
    "storyboards": {
      "description": "create_batch 必填：仅已有视频卡不足或用户明确要求新增时使用；先写好并检查全部包的提示词与 body，再一次传入整批。每项独立 key、body 或 body_path；默认最多 1000 项，并发 4 项提交，无需等待逐项完成。字段见 body。",
      "items": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "additionalProperties": true,
            "description": "create 与 body_path 二选一。创建字段：scriptId=当前项目远端 ID；episodeId=jubian_catalog episodes 返回的真实分集 ID（不是集号）；episodeCount=显示集号；scriptName=项目名；storyboardName=包名，如 EP01-P1；sortOrder=从 0 开始的包序号；isGenerate=0。视频模型、平台、比例、分辨率和风格沿用当前项目；每包 duration 按镜头内容计算，不能照抄项目默认时长。modelConfig 是 JSON 字符串：包含完整包 prompt、duration（整数秒，含收束）、modelId、platformId、ratio、resolution、genType、genNum=1、standardId、modelGenerationTypeId、videoStandardId；模型与选择器取当前 jubian_catalog models(task_type=1)，不要抄历史 ID。提示词必须写入 modelConfig.prompt，不能只放顶层 prompt；用到的已有素材在对应镜头的画面、动作或声音描述中内联使用 \`@[素材名称](material_key)\`，后续镜头再次提及时继续引用，不能只在顶部集中列出。只引用本包实际用到的现有素材，不为补引用新增资产，不把标记插入原文对白。图片 selections 按正文图片 key 首次出现的顺序去重后各绑定一次，正文重复引用不重复绑定；音频用 audio_preview/audio_apply，不混入图片 selections。get 的 model_config.prompt 是保存的提示词，material_keys 来自已绑定素材；新分镜 material_keys 为空不代表提示词为空。主体素材后续用 select_assets 写入；新建不要复制旧记录的 id、任务列表或账号字段。创建后从响应取 ID 并 get 回读核对提示词，再继续下一批；无需用户先手工创建样本。",
            "type": "object",
          },
          "body_path": {
            "description": "create 与 body 二选一：按 body 的字段说明生成并检查的本地 UTF-8 JSON 文件路径；一包一份请求体。",
            "type": "string",
          },
          "idempotency_key": {
            "description": "本项固定重放键；不得重复。",
            "type": "string",
          },
        },
        "required": [
          "idempotency_key",
        ],
        "type": "object",
      },
      "type": "array",
    },
    "subtitle_box": {
      "additionalProperties": true,
      "description": "erase_subtitle 可选：{zimuLeft,zimuTop,zimuWidth,zimuHeight}。省略时按画面尺寸推导提供方默认比例——通常不要传，工作台的预览坐标无法由调用方复现。",
      "type": "object",
    },
    "task_id": {
      "description": "task / subtasks 必填：视频任务 ID。",
      "type": "number",
    },
    "task_name": {
      "description": "erase_subtitle 可选：任务名，省略时按「<源任务名>-去字幕」生成。",
      "type": "string",
    },
    "video_height": {
      "description": "erase_subtitle 必填：画面高度。",
      "type": "number",
    },
    "video_previews": {
      "description": "submit_video_batch 必填：本次提交清单中同项目不同分镜的预览；先逐项预检与总预算预约，再有界并行提交。",
      "items": {
        "additionalProperties": false,
        "properties": {
          "estimate_basis": {
            "description": "本包估价依据：模型/平台、价格单位、时长/用量假设或同规格实际费用。提供估价时必填；估算不是实际结算金额。",
            "type": "string",
          },
          "estimated_cost_cny": {
            "description": "本包预计费用（人民币十进制字符串）。由 Agent 按项目所选模型的实时目录价格、包时长/用量或同规格已结算费用估算；不是让用户填写，也不改变每项目默认4000元额度。",
            "type": "string",
          },
          "idempotency_key": {
            "description": "本项 preview 自带的 fingerprint；重放保持原 key。",
            "type": "string",
          },
          "preview_path": {
            "description": "本项 prepare_video 返回的预览文件。",
            "type": "string",
          },
        },
        "required": [
          "preview_path",
          "idempotency_key",
        ],
        "type": "object",
      },
      "type": "array",
    },
    "video_width": {
      "description": "erase_subtitle 必填：画面宽度。",
      "type": "number",
    },
  },
  "required": [
    "method",
  ],
  "type": "object",
}
`;


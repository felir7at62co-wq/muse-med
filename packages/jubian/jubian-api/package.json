{
  "name": "@deepseek-ai/dsh-jubian-api",
  "description": "Typed Jubian endpoint readers over the shared Jubian transport",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-jubian": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-jubian": "workspace:^"
  }
}

{
  "name": "@deepseek-ai/dsh-muse-market",
  "version": "0.2.2-rc.1",
  "private": true,
  "description": "Skill publications with separate local storage, activation and optional account-bound cloud services",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package": {
      "types": "./lib/types/package.d.ts",
      "default": "./lib/package.js"
    },
    "./format": {
      "types": "./lib/types/format.d.ts",
      "default": "./lib/format.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./activation": {
      "types": "./lib/types/activation.d.ts",
      "default": "./lib/activation.js"
    },
    "./session": {
      "types": "./lib/types/session.d.ts",
      "default": "./lib/types/session.js"
    },
    "./cloud": {
      "types": "./lib/types/cloud.d.ts",
      "default": "./lib/cloud.js"
    },
    "./cloud-host": {
      "types": "./lib/types/cloud-host.d.ts",
      "default": "./lib/cloud-host.js"
    }
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "files": [
    "lib/index.js",
    "lib/package.js",
    "lib/format.js",
    "lib/activation.js",
    "lib/cloud.js",
    "lib/cloud-host.js",
    "lib/shared-*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-skill": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "fflate": "^0.8.3",
    "yaml": "^2.4.2",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-session-query": "workspace:*",
    "@deepseek-ai/dsh-scope": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-muse-account": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent-loop-testkit": "workspace:*",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "workspace:*",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:*",
    "@deepseek-ai/dsh-api-gateway": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-typert-registry": "workspace:*",
    "@deepseek-ai/dsh-typert-generator": "workspace:*",
    "@deepseek-ai/dsh-api-remote-access": "workspace:*",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-loader-smoke": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*"
  }
}

 _PLATFORM: Final = Platform.DOUYIN
 _NAME: Final = _PLATFORM.value
@@ -541,6 +542,61 @@ def parse_related_posts(payload: Mapping[str, Any], *, fetched_at: datetime) ->
     return Page(items=items, cursor=None, has_more=False)
 
 
+#: ``search_nil_info.search_nil_type`` when Douyin wants the searcher to pass
+#: a verification instead of answering; any other nil type is "nothing found".
+_SEARCH_VERIFY_NIL_TYPE: Final = "verify_check"
+
+
+def _search_root(payload: Mapping[str, Any]) -> Node:
+    root = _guard(payload)
+    nil = root.opt_child("search_nil_info")
+    if nil is not None and nil.get("search_nil_type") == _SEARCH_VERIFY_NIL_TYPE:
+        raise UpstreamRiskControl(
+            "douyin search asked for verification",
+            details={"platform": _NAME, "signal": f"search_nil:{_SEARCH_VERIFY_NIL_TYPE}"},
+        )
+    return root
+
+
+def _search_next(root: Node) -> tuple[str | None, bool]:
+    """The cursor of the next search page: the offset and the search session id."""
+    has_more = optional_bool(root.get("has_more"))
+    if not has_more:
+        return None, False
+    offset = optional_id(root.get("cursor"))
+    if offset is None:
+        raise root.missing("cursor")
+    log_pb = root.opt_child("log_pb")
+    search_id = optional_id(log_pb.get("impr_id")) if log_pb is not None else None
+    return search_cursor(offset, search_id), True
+
+
+def parse_search_posts(payload: Mapping[str, Any], *, fetched_at: datetime) -> Page[Content]:
+    """Parse ``/aweme/v1/web/search/item/``.
+
+    Each ``data`` entry wraps one post in ``aweme_info``. Entries without one
+    are cards the search page draws between posts, not posts, and are left out.
+    """
+    root = _search_root(payload)
+    items = [
+        content_from_node(post, fetched_at=fetched_at)
+        for entry in root.listed_children("data")
+        if (post := entry.opt_child("aweme_info")) is not None
+    ]
+    cursor, has_more = _search_next(root)
+    return Page(items=items, cursor=cursor, has_more=has_more)
+
+
+def parse_search_authors(payload: Mapping[str, Any]) -> Page[Author]:
+    """Parse ``/aweme/v1/web/discover/search/``: each ``user_list`` entry wraps ``user_info``."""
+    root = _search_root(payload)
+    items = [
+        author_from_node(entry.child("user_info")) for entry in root.listed_children("user_list")
+    ]
+    cursor, has_more = _search_next(root)
+    return Page(items=items, cursor=cursor, has_more=has_more)
+
+
 def music_web_url(music_id: str) -> str:
     return f"{WEB_DOMAIN}/music/{music_id}"
 

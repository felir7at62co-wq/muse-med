+#: What the search page says a query came from when it is typed into the box.
+SEARCH_SOURCE: Final = "normal_search"
+
+#: Separates the offset from the search session id inside a search cursor.
+_SEARCH_CURSOR_SEPARATOR: Final = ":"
+
+
+def _keyword(keyword: str) -> str:
+    text = str(keyword).strip()
+    if not text:
+        raise InvalidParam("a search needs a keyword", details={"field": "keyword"})
+    return text
+
+
+def search_cursor(offset: str, search_id: str | None) -> str:
+    """Encode the next search page as one opaque cursor.
+
+    Douyin pages a search by ``offset`` and ties the later pages to the first
+    answer's search session (``log_pb.impr_id``) through ``search_id``; both
+    have to come back, so both travel in the cursor.
+    """
+    return f"{offset}{_SEARCH_CURSOR_SEPARATOR}{search_id or ''}"
+
+
+def _search_page(cursor: str | None) -> tuple[str, str]:
+    """Decode a search cursor into ``(offset, search_id)``."""
+    if cursor is None or not cursor.strip():
+        return "0", ""
+    offset, _, search_id = cursor.strip().partition(_SEARCH_CURSOR_SEPARATOR)
+    return offset or "0", search_id
+
+
+def _search_params(
+    channel: str, keyword: str, cursor: str | None, count: int, profile: ClientProfile
+) -> dict[str, str]:
+    offset, search_id = _search_page(cursor)
+    params = {
+        **base_params(profile),
+        "search_channel": channel,
+        "enable_history": "1",
+        "keyword": _keyword(keyword),
+        "search_source": SEARCH_SOURCE,
+        "query_correct_type": "1",
+        "is_filter_search": "0",
+        "from_group_id": "",
+        "offset": offset,
+        "count": str(count),
+        "list_type": "single",
+        "search_id": search_id,
+    }
+    if offset == "0":
+        params["need_filter_settings"] = "1"
+    return params
+
+
+def search_posts_params(
+    *,
+    keyword: str,
+    cursor: str | None = None,
+    count: int = DEFAULT_PAGE_SIZE,
+    profile: ClientProfile = DEFAULT_PROFILE,
+) -> dict[str, str]:
+    """Parameters for ``/aweme/v1/web/search/item/``: the search page's video tab."""
+    return _search_params("aweme_video_web", keyword, cursor, count, profile)
+
+
+def search_authors_params(
+    *,
+    keyword: str,
+    cursor: str | None = None,
+    count: int = DEFAULT_PAGE_SIZE,
+    profile: ClientProfile = DEFAULT_PROFILE,
+) -> dict[str, str]:
+    """Parameters for ``/aweme/v1/web/discover/search/``: the search page's user tab."""
+    return _search_params("aweme_user_web", keyword, cursor, count, profile)

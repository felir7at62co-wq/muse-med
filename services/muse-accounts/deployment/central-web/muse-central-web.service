[Unit]
Description=Muse Central Web owner gateway
After=network-online.target muse-cloud.service muse-minimal-accounts.service muse-central-backend-cookie.service
Requires=muse-central-backend-cookie.service
Wants=network-online.target

[Service]
Type=simple
User=muse-central-web
Group=muse-central-web
WorkingDirectory=/opt/muse/central-web
Environment=MUSE_CENTRAL_CONFIG=/etc/muse-central-web/config.json
ExecStart=/opt/muse/cloud/runtime/node-v24.21.0/bin/node /opt/muse/central-web/central-web.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target

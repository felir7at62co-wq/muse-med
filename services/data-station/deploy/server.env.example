# Non-secret environment; proxySecret belongs only to identities.json and the private Nginx header configuration.
MUSE_DATA_MODE=server
MUSE_DATA_HOST=127.0.0.1
MUSE_DATA_PORT=19617
MUSE_DATA_PUBLIC_ORIGIN=https://muse.aigc-pipeline.cn
MUSE_DATA_IDENTITY_FILE=/srv/muse-data-web/access/identities.json
MUSE_DATA_DIRECTORY=/srv/muse-data-web/app/.data/live
MUSE_DATA_SEED_DEMO=0
MUSE_DATA_AUTO_COLLECT=1
MUSE_DATA_INTERVAL_HOURS=6
MUSE_DATA_COLLECTION_RETRY_MINUTES=30
# muse-session reuses the Muse website sign-in; use deploy/nginx-data-location.muse-session.conf.example with it.
MUSE_DATA_AUTHENTICATION=trusted-proxy
MUSE_DATA_NOVEL_ENABLED=1
MUSE_DATA_NOVEL_PYTHON=/srv/muse-data-web/app/.data/novel-runtime/bin/python3
# Set MUSE_DATA_NOVEL_CA_FILE only to an existing absolute system CA bundle if the Python trust store needs it.
# Douyin → TOS downloads: station copy of the TOS key (root:muse-data-web 640), written by the user's import script.
# MUSE_DATA_TOS_ENV_FILE=/srv/muse-data-web/access/tos.env
# MUSE_DATA_DOUYIN_OBJECT_ACCESS=public
# Transcription worker service token (private 0600 file owned by the service user); see docs/hit-transcription.md.
# MUSE_DATA_SERVICE_TOKEN_FILE=/srv/muse-data-web/access/service-token
# 绿泡泡 Mac collector token and optional Feishu custom-bot webhook (private files); see docs/lvpaopao.md.
# MUSE_DATA_LVPAOPAO_TOKEN_FILE=/srv/muse-data-web/access/lvpaopao-token
# MUSE_DATA_LVPAOPAO_ALERT_WEBHOOK_FILE=/srv/muse-data-web/access/lvpaopao-alert-webhook
# MUSE_DATA_LVPAOPAO_OFFLINE_MINUTES=20
# MUSE_DATA_HIT_RULES_FILE=/srv/muse-data-web/access/hit-rules.json
# Feishu department admission (Muse sign-in only); see docs/server-identity.md.
# MUSE_DATA_FEISHU_APP_FILE=/srv/muse-data-web/access/feishu-app.json
# MUSE_DATA_FEISHU_LINKS_FILE=/srv/muse-data-web/access/muse-feishu-links.json
# MUSE_DATA_ACCESS_DEPARTMENTS=用户甲组

# Include only inside the existing HTTPS server. Render the key into a root-only private copy.
location = /data {
    return 308 /data/;
}

location ^~ /data/ {
    auth_basic "Muse Data";
    auth_basic_user_file /srv/muse-data-web/access/htpasswd;
    client_max_body_size 21m;

    proxy_pass http://127.0.0.1:19617/;
    proxy_set_header Host 127.0.0.1:19617;
    proxy_set_header X-Muse-Data-Key "__REPLACE_IN_PRIVATE_CONFIG__";
    proxy_set_header X-Muse-Data-User $remote_user;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_set_header X-Forwarded-For "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
}

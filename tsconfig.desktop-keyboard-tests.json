{
  // The native/renderer integration fixture imports only Cordis-free Desktop modules.
  "extends": "./tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "lib/desktop-keyboard-test-types",
    "emitDeclarationOnly": true,
    "types": ["node"]
  },
  "files": [
    "apps/desktop/tests/keyboard.spec.ts",
    "apps/desktop/src/keyboard.ts",
    "apps/desktop/src/keybindings.ts",
    "apps/desktop/src/browser-guests.ts",
    "apps/desktop/src/ipc.ts",
    "apps/desktop/src/update-overlay.ts",
    // Reached by `ipc.ts`'s typed surface: the plugin catalogue and backend state it
    // names, and the profile/runtime modules those read. A `files` project must list
    // every file in its program.
    "apps/desktop/src/startup-error.ts",
    "apps/desktop/src/project-manager.ts",
    "apps/desktop/src/plugin-catalog.ts",
    "apps/desktop/src/locale.ts",
    "apps/desktop/src/backend-controller.ts",
    "apps/desktop/src/core-package-set.ts",
    "apps/desktop/src/paths.ts",
    "apps/desktop/src/owned-directory.ts",
    "apps/desktop/src/release.ts",
    "apps/desktop/src/runtime-tree.ts",
    "apps/desktop/src/profile-packages.ts",
    "apps/desktop/src/host-protocol.ts"
  ],
  "include": [],
  "references": [
    { "path": "./packages/client/shortcuts/tsconfig.client.json" },
    { "path": "./packages/client/ui-sidebar-browser/tsconfig.client.json" },
    { "path": "./packages/util/atomic-write" }
  ]
}

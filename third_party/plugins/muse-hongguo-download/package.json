{
  "name": "muse-hongguo-download",
  "version": "0.2.0",
  "description": "Muse Hongguo downloads using the pinned jackotom/hongguo-drama engine",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./cli": {
      "types": "./src/cli.d.ts",
      "default": "./src/cli.js"
    },
    "./tasks": {
      "types": "./src/tasks.d.ts",
      "default": "./src/tasks.js"
    },
    "./profiles/hongguo/*": "./profiles/hongguo/*",
    "./merger": {
      "types": "./src/merger.d.ts",
      "default": "./src/merger.js"
    }
  },
  "files": [
    "src/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "LICENSE",
    "SOURCE.json",
    "upstream/",
    "NOTICE",
    "scripts/bundle-upstream.mjs",
    "LICENSE-Muse-original",
    "patches/",
    "profiles/",
    "CLI.md",
    "CLI.zh.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "package": "node scripts/pack.mjs",
    "test:live": "node --import tsx/esm scripts/live-smoke.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.2-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-brand": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "GPL-3.0"
}

{
  "name": "muse-hongguo-search",
  "version": "0.1.0",
  "description": "Muse/DSH 红果官方公开搜索、详情、榜单与百万收藏筛选工具集",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": "./src/client.js",
    "./parser": "./src/parser.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SOURCES.md",
    "CHANGELOG.md",
    "VALIDATION.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js && node --check src/client.js && node --check src/parser.js && node scripts/check-package.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "package": "node scripts/pack.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felir7at62co-wq/muse-hongguo-serch.git"
  },
  "bugs": {
    "url": "https://github.com/felir7at62co-wq/muse-hongguo-serch/issues"
  }
}

+import fs from 'node:fs';
+import {fileURLToPath} from 'node:url';
+
+const manifest=JSON.parse(fs.readFileSync(new URL('../package.json',import.meta.url),'utf8'));
+const original=manifest.museAdapter?.upstreamVersion;
+const version=manifest.version;
+if(!/^\d+\.\d+\.\d+$/.test(original||'')||!version.startsWith(original+'-muse.'))throw Error('Not a pinned Muse adaptation');
+const file=fileURLToPath(new URL('../client.js',import.meta.url));
+let source=fs.readFileSync(file,'utf8');
+const literals=[['"'+original+'"','"'+version+'"',4],['\\u793E\\u533A\\u7248 '+original+'"','\\u793E\\u533A\\u7248 '+version+'"',1]];
+for(const [before,after,expected] of literals){
+  const count=source.split(before).length-1;
+  if(count===0&&source.split(after).length-1===expected)continue;
+  if(count!==expected)throw Error('Unknown client version layout; rebuild or review before editing');
+  source=source.split(before).join(after);
+}
+if(source!==fs.readFileSync(file,'utf8'))fs.writeFileSync(file,source);
+console.log('Client version: '+version);

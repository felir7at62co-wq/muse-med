+import { createHash } from "node:crypto";
+import path from "node:path";
+
+// This exact shipped class already suppresses expected shutdown errors while
+// reporting unexpected exits and requiring a clean update handoff.
+const VERIFIED_MUSE_CLOSE = "ed4b1682ac4deda715249c0e2e433f5767d10b9b3e70927b5e1f7ebe635dc121";
+
+/** Return the unique shipped DesktopHostProcess class without executing it. */
+export function museHostProcessSource(text) {
+  const source = String(text).replace(/\r\n/g, "\n");
+  const start = source.indexOf("var DesktopHostProcess = class {");
+  if (start < 0 || source.indexOf("var DesktopHostProcess = class {", start + 1) >= 0) return null;
+  const end = source.indexOf("\n};", start);
+  return end < 0 ? null : source.slice(start, end + 3);
+}
+
+/** Identify the narrow, behavior-tested Muse shutdown implementation. */
+export function verifiedMuseClose(text) {
+  const source = museHostProcessSource(text);
+  if (source === null) return false;
+  const closeStart = source.indexOf("\t\tthis.exitPromise = new Promise((resolve) => {");
+  const closeEnd = source.indexOf("\n\t\treturn this.readyPromise;", closeStart);
+  const stopStart = source.indexOf("\n\tasync stop(requireGraceful = false) {");
+  const classEnd = source.lastIndexOf("\n};");
+  if (closeStart < 0 || closeEnd < closeStart || stopStart < 0 || classEnd < stopStart) return false;
+  const lifecycle = source.slice(closeStart, closeEnd) + "\n" + source.slice(stopStart, classEnd);
+  return createHash("sha256").update(lifecycle).digest("hex") === VERIFIED_MUSE_CLOSE;
+}
+
+/**
+ * Exclude DSH-only shell patches using product identity and source evidence.
+ * Unknown products and modified shutdown implementations retain normal drift
+ * diagnostics. A native exclusion is reported as not applicable, not applied.
+ */
+export function musePatchDisposition(patch, files, io) {
+  if (![45, 46, 83, 84].includes(patch?.id)) return null;
+  const entries = Array.isArray(files?.["desktop-shell"]) ? files["desktop-shell"] : [files?.["desktop-shell"]].filter(Boolean);
+  if (entries.length !== 1) return null;
+  const entry = path.resolve(entries[0]);
+  const productDir = path.dirname(path.dirname(entry));
+  let manifest;
+  try { manifest = JSON.parse(io.readFileSync(path.join(productDir, "package.json"), "utf8")); }
+  catch { return null; }
+  if (manifest.name !== "muse-med" || typeof manifest.main !== "string" || path.resolve(productDir, manifest.main) !== entry) return null;
+  if (patch.id === 45 || patch.id === 46) {
+    return { status: "na", reason: "muse_owns_desktop_updates", product: manifest.name, version: manifest.version, path: entry };
+  }
+  if (manifest.version !== "1.2.8") return null;
+  let source;
+  try { source = io.readFileSync(entry, "utf8"); }
+  catch { return null; }
+  if (!verifiedMuseClose(source)) return null;
+  return { status: "na", reason: "verified_native_muse_shutdown", product: manifest.name, version: manifest.version, path: entry, sha256: VERIFIED_MUSE_CLOSE };
+}

+import path from 'node:path';
+import {createHash} from 'node:crypto';
+import {hostFs,fsFor} from './extract-asar.js';
+import {atomicFiles} from './atomic-files.js';
+import {acquireMaintenanceLock} from './maintenance-lock.js';
+
+const SUFFIX='.dshpurge.bak';
+const digest=value=>createHash('sha256').update(value).digest('hex');
+const isHash=value=>typeof value==='string'&&/^[a-f0-9]{64}$/.test(value);
+const key=file=>path.resolve(file);
+
+// A missing desktop entry is not returned by targetFiles. Recover its exact
+// declaration from this selected app's manifest, while retaining the same
+// lexical/physical boundary that the normal existing-entry resolver enforces.
+export function declaredDesktopBackupTarget(appDir,fs=hostFs) {
+  const app=key(appDir);
+  const inside=(root,file)=>{
+    const rel=path.relative(root,file);
+    return rel!==''&&rel!=='..'&&!rel.startsWith('..'+path.sep)&&!path.isAbsolute(rel);
+  };
+  try {
+    const meta=JSON.parse(fs.readFileSync(path.join(app,'package.json'),'utf8').replace(/^\uFEFF/,''));
+    const main=meta?.main;
+    if(typeof main!=='string'||!main.trim()||main.includes('\0')||path.posix.isAbsolute(main)||path.win32.isAbsolute(main)||/^[A-Za-z]:/.test(main))return null;
+    const file=path.resolve(app,main.replaceAll('\\','/'));
+    if(!inside(app,file))return null;
+    const appReal=fs.realpathSync(app);
+    let ancestor=file;
+    while(true){
+      try {
+        const real=fs.realpathSync(ancestor);
+        if(real!==appReal&&!inside(appReal,real))return null;
+        return file;
+      }catch(error){if(error.code!=='ENOENT')return null;}
+      const parent=path.dirname(ancestor);if(parent===ancestor)return null;ancestor=parent;
+    }
+  }catch{return null;}
+}
+
+export class BackupLedger {
+  constructor(aiBase,{fs=hostFs,allowedTargets=[]}={}) {
+    this.fs=fs;
+    this.base=key(aiBase);
+    this.file=path.join(this.base,'.dshpurge-backup-ledger.json');
+    this.allowedTargets=new Set(allowedTargets.map(key));
+    this.lockDirectory=path.join(this.base,'.dshpurge-ledger-lock');
+    this.atomic=atomicFiles(fs);
+    this.read();
+  }
+  read() {
+    try {
+      const raw=this.fs.readFileSync(this.file,'utf8');
+      const doc=JSON.parse(raw);
+      if(doc.schema!==1||doc.host!==this.base||!doc.entries||Array.isArray(doc.entries)||typeof doc.entries!=='object')throw Error('invalid schema or host');
+      for(const [file,entry] of Object.entries(doc.entries)){
+        if(!path.isAbsolute(file)||key(file)!==file||!this.ownsPath(file))throw Error('backup path is outside this host');
+        if(!entry||!isHash(entry.backup)||typeof entry.source!=='string'||!Array.isArray(entry.outputs)||!entry.outputs.every(isHash))throw Error('invalid backup identity');
+      }
+      this.doc=doc;
+      this.diskHash=digest(raw);
+    } catch(error) {
+      if(error.code!=='ENOENT')throw Error('Backup ledger unreadable; files and backups retained: '+error.message);
+      this.doc={schema:1,host:this.base,entries:{}};
+      this.diskHash=null;
+    }
+  }
+  ownsPath(file) {
+    const fp=key(file), rel=path.relative(this.base,fp);
+    const inside=rel===''||(!rel.startsWith('..'+path.sep)&&rel!=='..'&&!path.isAbsolute(rel));
+    if(!inside)return this.allowedTargets.has(fp);
+    // A lexically contained path may still escape through a junction/symlink.
+    let ancestor=fp;
+    while(true){
+      try {
+        const real=this.fs.realpathSync(ancestor), baseReal=this.fs.realpathSync(this.base);
+        const relative=path.relative(baseReal,real);
+        return relative===''||(!relative.startsWith('..'+path.sep)&&relative!=='..'&&!path.isAbsolute(relative));
+      }catch(error){if(error.code!=='ENOENT')throw error;}
+      const parent=path.dirname(ancestor);if(parent===ancestor)return false;ancestor=parent;
+    }
+  }
+  trackedFiles(){return Object.keys(this.doc.entries);}
+  save() {
+    if(!this.ownsPath(this.lockDirectory))throw Error('Backup lock path escapes host');
+    this.fs.mkdirSync(this.lockDirectory,{recursive:true});
+    // The routing facade does not expose linkSync; lock operations need the
+    // selected complete filesystem (original-fs while an ASAR is present).
+    const lock=acquireMaintenanceLock(this.lockDirectory,{fs:fsFor(this.lockDirectory)});
+    let failure;
+    try {
+      let current=null;
+      try {current=digest(this.fs.readFileSync(this.file));}catch(error){if(error.code!=='ENOENT')throw error;}
+      if(current!==this.diskHash)throw Error('Backup ledger changed during this operation; retained for review');
+      const next=JSON.stringify(this.doc,null,2)+'\n';
+      lock.check();
+      this.atomic.atomicWriteSync(this.file,next);
+      this.diskHash=digest(next);
+    } catch(error){failure=error;}
+    const warning=lock.release();
+    if(failure)throw failure;
+    if(warning)throw Error('Backup ledger lock release failed; retained for review');
+  }
+  hash(file) {return digest(this.fs.readFileSync(file));}
+  backupHash(file){
+    const stat=this.fs.lstatSync(file);
+    if(!stat.isFile()||stat.isSymbolicLink())throw Error('Backup is not a regular file');
+    return this.hash(file);
+  }
+  source(file) {
+    const packages=[];
+    for(const name of ['dsh-base','dsh-agent-loop','dsh-system-prompt']){
+      try {const raw=this.fs.readFileSync(path.join(this.base,name,'package.json'));packages.push([name,digest(raw)]);}catch(error){if(error.code!=='ENOENT')throw error;}
+    }
+    let directory=path.dirname(key(file));
+    for(let count=0;count<16;count++){
+      try {const raw=this.fs.readFileSync(path.join(directory,'package.json'));packages.push(['owner',key(path.join(directory,'package.json')),digest(raw)]);break;}
+      catch(error){if(error.code!=='ENOENT')throw error;}
+      const parent=path.dirname(directory);if(parent===directory)break;directory=parent;
+    }
+    return digest(JSON.stringify(packages));
+  }
+  baseline(file) {
+    const fp=key(file), backup=this.backupHash(fp+SUFFIX), current=this.hash(fp);
+    if(!this.ownsPath(fp))throw Error('Backup path is outside this host');
+    const entry=this.doc.entries[fp];
+    if(!entry){
+      if(current!==backup)throw Error('Untracked backup differs from current file; retained for review');
+      this.doc.entries[fp]={backup,source:this.source(fp),outputs:[]};this.save();return;
+    }
+    const result=this.inspect(fp);
+    if(!result.ok)throw Error(result.reason);
+  }
+  inspect(file) {
+    const fp=key(file), entry=this.doc.entries[fp];
+    try {
+      if(!this.ownsPath(fp))return {ok:false,reason:'backup_path_outside_host'};
+      let backup;
+      try{backup=this.backupHash(fp+SUFFIX);}catch(error){
+        if(error.code==='ENOENT'&&entry){
+          const canCreate=this.canCreateBackup(fp);
+          return {...canCreate,backupMissing:true};
+        }
+        throw error;
+      }
+      if(entry&&backup!==entry.backup)return {ok:false,reason:'backup_hash_changed'};
+      if(entry&&this.source(fp)!==entry.source)return {ok:false,reason:'host_upgrade_requires_rebaseline'};
+      let current;
+      try {current=this.hash(fp);}catch(error){
+        if(error.code==='ENOENT'&&entry)return {ok:true,missing:true,backup};
+        throw error;
+      }
+      if(!entry)return {ok:current===backup,reason:'untracked_backup',current,backup};
+      return {ok:current===entry.backup||entry.outputs.includes(current),reason:'unrecognized_current_content',current,backup};
+    } catch(error){return {ok:false,reason:'backup_identity_read_error: '+error.message};}
+  }
+  canCreateBackup(file) {
+    const fp=key(file), entry=this.doc.entries[fp];
+    if(!this.ownsPath(fp))return {ok:false,reason:'backup_path_outside_host'};
+    if(!entry)return {ok:true};
+    try{
+      if(this.source(fp)!==entry.source)return {ok:false,reason:'host_upgrade_requires_rebaseline'};
+      if(this.hash(fp)!==entry.backup)return {ok:false,reason:'missing_original_backup_cannot_rebuild_from_patched_or_unknown_content'};
+      return {ok:true};
+    }catch(error){return {ok:false,reason:'backup_rebuild_read_error: '+error.message};}
+  }
+  applied(file,expected) {
+    const fp=key(file), entry=this.doc.entries[fp];
+    if(!entry)throw Error('Missing backup ledger entry for applied file');
+    if(!isHash(expected)||this.hash(fp)!==expected)throw Error('Applied output changed before it could be recorded');
+    if(this.backupHash(fp+SUFFIX)!==entry.backup||this.source(fp)!==entry.source)throw Error('Backup/source identity changed while applying');
+    if(!entry.outputs.includes(expected)){entry.outputs.push(expected);this.save();}
+  }
+}
+
+export {digest as backupContentHash};
